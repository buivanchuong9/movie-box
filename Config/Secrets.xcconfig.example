// Copy this file to Config/Secrets.xcconfig.
// Secrets.xcconfig is gitignored. Leave values empty in git.
// A TMDB v3 key and/or a v4 read access token can be used.
// Do not commit a real credential. The production app does not ask people to type one.

TMDB_API_KEY =
TMDB_ACCESS_TOKEN =

// Optional https links. Leave empty to keep the in-app Terms and Privacy text.
LUMEN_TERMS_URL =
LUMEN_PRIVACY_URL =
